{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NounoursLauncher",
  "version": "0.2.1",
  "identifier": "fr.nounourscorp.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NounoursLauncher",
        "width": 1200,
        "height": 780,
        "minWidth": 860,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: http:; img-src 'self' https: http: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "NounoursCorp",
    "category": "Utility",
    "shortDescription": "Tous les projets NounoursCorp au même endroit",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "French"
        ],
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ5RTc3ODQ0RjYxNThFNzcKUldSM2poWDJSSGpuU1pNVCs1VHAxNW5xN0piSGFydE9FNnhuOWhKMHZjM3FWSkoyUG5WMTN2NUEK",
      "endpoints": [
        "https://nounourscorp.fr/launcher/api.php?r=launcher/update&target={{target}}&arch={{arch}}&current={{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
