{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Droits de la fenêtre principale",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    },
    "process:allow-restart"
  ]
}
